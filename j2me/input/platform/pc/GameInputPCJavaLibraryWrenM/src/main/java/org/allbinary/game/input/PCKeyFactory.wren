    isSubmission(input) {
        if ((input == _ENTER)) {
            return true
        }
        return false
    }
    

    isDelete(input) {
        if ((input == _DEL)) {
            return true
        }
        return false
    }
    

    isBackSpace(input) {
        if ((input == _BACK_SPACE)) {
            return true
        }
        return false
    }
    

    isUp(input) {
        if (((input == _DPAD_UP) || (input == _DPAD_UP2))) {
            return true
        }
        return false
    }
    

    isDown(input) {
        if (((input == _DPAD_DOWN) || (input == _DPAD_DOWN2))) {
            return true
        }
        return false
    }
    

    isLeft(input) {
        if (((input == _DPAD_LEFT) || (input == _DPAD_LEFT2))) {
